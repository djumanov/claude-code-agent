# Copy to .env and fill in. Both are optional: without them you can still
# drop files in manually (see SETUP.md, "Manual mode").

# Tella → Settings → API keys  (https://www.tella.com)
TELLA_API_KEY=

# Epidemic Sound Partner API (requires a partner agreement + Developer Portal credentials)
EPIDEMIC_ACCESS_KEY_ID=
EPIDEMIC_ACCESS_KEY_SECRET=
# Needed to download premium tracks: the ID of the subscribed user you link in your app
EPIDEMIC_USER_ID=

# Optional overrides
# TELLA_API_BASE=https://api.tella.com/v1
# EPIDEMIC_API_BASE=https://partner-content-api.epidemicsound.com
